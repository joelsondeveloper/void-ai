# Copy to .env and fill in values locally.
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Enable only if you authorize ElevenLabs synthesis, which may consume paid credits.
VOID_ELEVENLABS_TTS=0

# AgentRenderer uses a free OpenRouter route in the web runtime.
# VOID_RENDERER_MODEL=nvidia/nemotron-3.5-super-vl:free
# VOID_RENDERER_MAX_OUTPUT_TOKENS_HIGH=1800
# VOID_DEV_MAX_OUTPUT_TOKENS_HIGH=8000
